# Database Configuration
# PostgreSQL connection string
# Example: postgresql://user:password@host:5432/database
# Get from: Vercel Postgres, Supabase, Neon, or any PostgreSQL provider
DATABASE_URL="postgresql://user:password@localhost:5432/lovable_clone"

# AI Provider API Keys
# Google Gemini API Key for AI code generation
# Get from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Code Execution Sandbox
# E2B API Key for running code in isolated sandboxes
# Get from: https://e2b.dev/
E2B_API_KEY=your_e2b_api_key_here

# Inngest Configuration (Optional - for background job processing)
# Get from: https://www.inngest.com/
INNGEST_EVENT_KEY="your_inngest_event_key_here"
INNGEST_SIGNING_KEY="your_inngest_signing_key_here"

# Next.js Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: OpenAI (if you want to use GPT models instead of Gemini)
OPENAI_API_KEY="your_openai_api_key_here"

# Optional: Anthropic Claude (alternative AI provider)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
