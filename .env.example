# ============================================
# DATABASE CONFIGURATION (MONGODB - SHARED WITH WEB APP)
# ============================================
# MongoDB connection string (same as WEB folder)
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/vettcode?retryWrites=true&w=majority&appName=vettcode&serverSelectionTimeoutMS=10000&socketTimeoutMS=45000&connectTimeoutMS=10000"

# ============================================
# AI PROVIDER API KEYS - Need at least one
# ============================================
# Google Gemini API Key (RECOMMENDED - Free tier available)
# Get from: https://ai.google.dev/
GEMINI_API_KEY="your_gemini_api_key_here"

# OpenAI API Key (GPT models)
# Get from: https://platform.openai.com
OPENAI_API_KEY="your_openai_api_key_here"

# Anthropic Claude API Key
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Groq API Key (Fast inference)
# Get from: https://console.groq.com
GROQ_API_KEY="your_groq_api_key_here"

# ============================================
# CODE EXECUTION SANDBOX - REQUIRED
# ============================================
# E2B API Key for running code in isolated sandboxes
# Get from: https://e2b.dev/
E2B_API_KEY="your_e2b_api_key_here"

# ============================================
# BACKGROUND JOB PROCESSING - REQUIRED
# ============================================
# Inngest Configuration (for code generation agent)
# Get from: https://www.inngest.com/
INNGEST_EVENT_KEY="your_inngest_event_key_here"
INNGEST_SIGNING_KEY="your_inngest_signing_key_here"

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# OPTIONAL: Vercel AI Gateway
# ============================================
# Provides unified access to multiple AI models
# Get from: https://vercel.com/dashboard/ai-gateway/api-keys
AI_GATEWAY_API_KEY="your_ai_gateway_api_key_here"
